// This is your Prisma schema file for MongoDB

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum CategoryType {
  PROFESSIONAL_CONSULTANT
  SERVICE_AND_RETAIL_BRANDS
}

enum ConsultantKind {
  INDEPENDENT
  CONSULTANCY
}

enum ProfileStatus {
  PENDING_PAYMENT
  ACTIVE
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
}

model Admin {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  firstName    String
  lastName     String
  passwordHash String
  role         AdminRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  auditLogs           AuditLog[]
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  adminId   String    @db.ObjectId
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id])
}

model RefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  adminId   String    @db.ObjectId
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  admin Admin @relation(fields: [adminId], references: [id])
}

enum OtpPurpose {
  REGISTER
  LOGIN
}

model User {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String    @unique
  phone       String    @unique
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens UserRefreshToken[]
  profiles      Profile[]
  payments      Payment[]
}

model UserRefreshToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash String    @unique
  userId    String    @db.ObjectId
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model OtpCode {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  phone      String
  purpose    OtpPurpose
  // MSG91 OTP widget request id (production); codeHash is only used in local dev mode
  reqId      String?
  codeHash   String?
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  // Pending registration details, persisted only after OTP verification
  name       String?
  email      String?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

// "Category Type" in the UI: groups categories within a profile type
// (e.g. Licenced Practitioners / Statutory Professionals)
model CategoryGroup {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      CategoryType
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  categories Category[]

  @@unique([type, name])
  @@index([type, sortOrder])
}

model Category {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  urlSlug             String?
  type                CategoryType
  groupId             String?        @db.ObjectId
  isSubCategoryNeeded Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  group         CategoryGroup? @relation(fields: [groupId], references: [id])
  subCategories SubCategory[]
  profiles      Profile[]

  @@index([type])
  @@index([groupId])
  @@index([urlSlug])
}

model SubCategory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  urlSlug    String?
  categoryId String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id])
  profiles Profile[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([urlSlug])
}

model Profile {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  status              ProfileStatus   @default(ACTIVE)
  isDisabled          Boolean         @default(false)
  categoryId          String          @db.ObjectId
  subCategoryId       String?         @db.ObjectId
  // Only for PROFESSIONAL_CONSULTANT
  consultantKind      ConsultantKind?
  // Name (independent) / Name of entity (consultancy) / Name of service or retail brand
  name                String
  // Consultancy only: name of the consultant
  consultantName      String?
  // Independent consultant only
  degrees             String?
  registrationNumber  String?
  // Core / primary services (shown on the card, max 80 chars)
  servicesOffered     String
  // All services / areas of practice in detail (profile popup only)
  servicesDetail      String?
  // Practicing since / Established in / Serving since (YYYY)
  sinceYear           String
  isWomenEntrepreneur Boolean         @default(false)
  contactNumbers      String[]
  emails              String[]
  address             Address
  workingHours        WorkingHours
  languages           String[]
  // Owner account (one profile per user — enforced in the service)
  userId              String?         @db.ObjectId
  // Admin who created the profile (null when self-registered)
  profileCreatedById  String?         @db.ObjectId
  publishedAt         DateTime?
  // Set when the listing fee has been paid (self-service or via a payment link)
  paidAt              DateTime?
  // Admin-generated payment link token (only allows paying this profile's fee); replaced when regenerated
  paymentLinkToken    String?
  // Fields from the pre-2026 profile format, kept for reference
  legacy              Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  category    Category     @relation(fields: [categoryId], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  payments    Payment[]

  @@index([categoryId])
  @@index([subCategoryId])
  @@index([status, isDisabled])
  @@index([userId])
  @@index([paymentLinkToken])
  @@index([name])
}

model Payment {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  // Kept (as null) if the profile is later deleted, so payment records survive
  profileId         String?       @db.ObjectId
  userId            String        @db.ObjectId
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  // Amount in paise
  amount            Int
  currency          String
  status            PaymentStatus
  paidAt            DateTime?
  // GST invoice, assigned when the payment is confirmed (e.g. VcPro/25-26/0001)
  invoiceNumber     String?
  invoiceDate       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id])

  @@index([profileId])
  @@index([userId])
  @@index([invoiceNumber])
}

// Running invoice serial per Indian financial year (e.g. "25-26")
model InvoiceCounter {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  financialYear String @unique
  seq           Int    @default(0)
}

type Address {
  buildingMallPropertyName      String?
  doorShopNo                    String?
  floor                         String?
  streetLaneRoadNameSubLocality String?
  nearestLandmark               String?
  secondaryPrimaryLocality      String?
  cityTown                      String?
  stateProvince                 String?
  country                       String?
  pinCodeZipCode                String?
}

// Times are 24h "HH:mm"
type DaySchedule {
  closed     Boolean @default(false)
  open       String?
  close      String?
  breakStart String?
  breakEnd   String?
}

type WorkingHours {
  // Monday – Friday
  weekdays DaySchedule
  saturday DaySchedule
  sunday   DaySchedule
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId   String?  @db.ObjectId
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin Admin? @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

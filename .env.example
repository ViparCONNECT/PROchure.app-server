# Application
NODE_ENV=development
PORT=3000

# MongoDB replica set connection string (Docker Compose)
DATABASE_URL="mongodb://mongo1:27017,mongo2:27017,mongo3:27017/nestjs_db?replicaSet=rs0"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Super Admin bootstrap (used only by seed script)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe@1234
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Password policy
PASSWORD_MIN_LENGTH=8

# Nodemailer (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@example.com
MAIL_PASS=smtp_password
MAIL_FROM="No Reply <no-reply@example.com>"

# Password reset token TTL in minutes
PASSWORD_RESET_TTL_MINUTES=30

# Frontend base URL (used in reset link)
FRONTEND_URL=http://localhost:5173
